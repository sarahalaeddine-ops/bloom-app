# Copy to .env.local and fill in. All are optional: without them Bloom runs as an offline demo.
# Full list with notes: README.md → "Environment variables".

# Password for the private demo (/demo-7q4x) and the Nora API. Unset = both stay locked.
DEMO_PASSWORD=

# Nora AI (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
NORA_MODEL=
# 1 = live Nora only for verified Supabase accounts (local/demo callers get offline answers).
NORA_REQUIRE_AUTH=

# App build only (npm run build:app): hosted site for /api/* and public pages. Leave unset on Vercel.
# Default https://bloomivfcompanion.com
NEXT_PUBLIC_API_BASE=

# Waitlist storage (set automatically when a Vercel Blob store is connected to the project)
BLOB_READ_WRITE_TOKEN=

# Supabase cloud accounts + sync (run supabase/schema.sql first). Public by design; RLS protects data.
# Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret for full account deletion (/api/account/delete). NEVER add a NEXT_PUBLIC_ prefix.
# Supabase -> Project Settings -> API keys: legacy service_role JWT or a new sb_secret_... key.
SUPABASE_SERVICE_ROLE_KEY=
